#!/bin/sh
set -eu

scope=${1:-all}
case "$scope" in
    api) tests='fit-diagnostics formula-streams mgcv-export effects effect-composition marginaleffects smooth-tests effect-wood-tests information-criteria effect-inference' ;;
    design) tests='axis-irf automatic-simplification group-penalty identifiability predictor-centering predictor-scaling' ;;
    gaussian) tests='compressed pairwise-sum chunk-crossprod condition-indicator penalty-logdet newton-refinement optimizer-diagnostics boundary-reduction checkpoint-progress randomized-equivalence schur-factor sparse-factor-smooth sparse-tensor-interaction sparse-gcv sparse-selected-inverse sparse-boundary-hessian sparse-robustness sparse-singular-system' ;;
    generalized) tests='generalized-families generalized-gcv generalized-curvature' ;;
    distributional) tests='distributional-checkpoint distributional-native distributional-qncv distributional-score distributional-efs' ;;
    optimizer) tests='boundary-reduction newton-refinement optimizer-diagnostics checkpoint-progress hybrid-transition parallelism sparse-gcv sparse-selected-inverse sparse-boundary-hessian generalized-gcv distributional-qncv' ;;
    recovery) tests='mixed-recovery nonlinear-recovery synthetic-recovery varying-recovery' ;;
    all) tests='automatic-simplification axis-irf boundary-reduction checkpoint-progress compressed pairwise-sum chunk-crossprod condition-indicator penalty-logdet newton-refinement optimizer-diagnostics distributional-checkpoint distributional-native distributional-qncv distributional-score distributional-efs effects effect-composition fit-diagnostics formula-streams group-penalty mgcv-export generalized-families generalized-gcv generalized-curvature hybrid-transition identifiability marginaleffects mixed-recovery nonlinear-recovery parallelism predictor-centering predictor-scaling randomized-equivalence schur-factor sparse-factor-smooth sparse-tensor-interaction sparse-gcv sparse-selected-inverse sparse-singular-system sparse-boundary-hessian sparse-robustness smooth-tests effect-wood-tests information-criteria effect-inference synthetic-recovery varying-recovery' ;;
    *)
        if [ -f "tests/$scope.R" ]; then
            tests=$scope
        else
            echo "Unknown test scope: $scope" >&2
            exit 2
        fi
        ;;
esac

if [ "${R_BIN+x}" = x ]; then
    r_bin=$R_BIN
else
    r_bin=$(command -v R)
fi

temporary_root=${TMPDIR:-/tmp}
if [ ! -d "$temporary_root" ] || [ ! -w "$temporary_root" ]; then
    temporary_root=/tmp
fi
test_library=$(mktemp -d "$temporary_root/cdrgam-test-lib.XXXXXX")
source_copy=$(mktemp -d "$temporary_root/cdrgam-test-source.XXXXXX")
trap 'rm -rf "$test_library" "$source_copy"' EXIT HUP INT TERM
mkdir -p "$test_library/cache"
export XDG_CACHE_HOME="$test_library/cache"
mkdir "$source_copy/cdrgam"
cp -R DESCRIPTION LICENSE NAMESPACE R man src tests \
    "$source_copy/cdrgam/"
"$r_bin" CMD INSTALL --preclean -l "$test_library" \
    "$source_copy/cdrgam" >/dev/null

for test_name in $tests; do
    test_file="$source_copy/cdrgam/tests/$test_name.R"
    echo "RUN tests/$test_name.R"
    R_LIBS="$test_library${R_LIBS:+:$R_LIBS}" \
        "$r_bin" --vanilla --slave -f "$test_file"
done
