% Generated manually from cdrgam/R/diagnostics.R.
\name{simulate_cdr}
\alias{simulate_cdr}
\title{Simulate irregular streams from fixed impulse-response functions}
\usage{
simulate_cdr(
  irfs,
  n_impulses = 500,
  n_responses = 600,
  duration = 60,
  window = 2,
  intercept = 0,
  noise_sd = 1,
  seed = NULL
)
}
\arguments{
\item{irfs}{Named non-empty list of functions. One-argument functions define
linear lag IRFs; two-argument functions of lag and predictor value define
nonlinear tensor IRFs.}
\item{n_impulses}{Number of impulses.}
\item{n_responses}{Number of responses.}
\item{duration}{Duration of the simulated series.}
\item{window}{Maximum causal lag included in the convolution.}
\item{intercept}{Response intercept.}
\item{noise_sd}{Gaussian response noise standard deviation.}
\item{seed}{Optional random seed.}
}
\value{A list containing impulse and response data, IRFs, noiseless components,
and simulation settings.}
\description{Creates irregular impulse and response times. Predictor columns
are sample-orthogonal and standardized, and responses are generated by the
additive convolution of the supplied ground-truth IRFs plus Gaussian noise.}
